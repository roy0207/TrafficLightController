{
  "name": "TrafficLightSys Codespace",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13"
    }
  },

  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install pybind11",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "twxs.cmake"
      ]
    }
  }
}